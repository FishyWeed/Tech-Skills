{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.ctx/ctx.py\" load --slim"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.ctx/ctx.py\" recall"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.ctx/ctx.py\" autosave --hook claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python .ctx/ctx.py save*)"
    ]
  }
}
